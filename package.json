{
  "name": "studydeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cited chat over my own class notes, powered by the Claude Code CLI",
  "scripts": {
    "css": "tailwindcss -i public/input.css -o public/app.css --minify",
    "build": "npm run css",
    "dev": "npm run css && tsx watch src/server.ts",
    "start": "npm run css && tsx src/server.ts",
    "sync": "tsx src/sync-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
